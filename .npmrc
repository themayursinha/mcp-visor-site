# Supply-chain hardening (card t_546aa53b, Google GTIG guidance).
# - ignore-scripts: no package lifecycle script runs on install. Verified safe:
#   the only hasInstallScript entry in package-lock.json is fsevents
#   (macOS-only optional dep, unused on Linux CI), and `npm run build`
#   passes with scripts disabled (Vite 8 needs no postinstall build step).
# - minimumReleaseAge: quarantine freshly published packages >= 24h (1440m).
#   Enforced by npm 11+; older npm ignores it (Dependabot's native cooldown
#   covers automated updates in the meantime).
ignore-scripts=true
minimumReleaseAge=1440
